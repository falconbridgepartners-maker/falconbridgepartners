# Public site origin (used in canonical URLs, sitemap, RSS, OG tags).
# Set this in Vercel for both Production and Preview environments.
NEXT_PUBLIC_SITE_URL=https://falconbp.com

# --- Keystatic (GitHub mode) ---
# Created from a GitHub App owned by the falconbridgepartners-maker account
# and installed on the falconbridgepartners repo. Editors sign in through
# GitHub OAuth; every save is a commit attributed to the signed-in editor.
#
# Set these in Vercel (Production only is fine — the /keystatic UI is served
# from the deployed site).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
