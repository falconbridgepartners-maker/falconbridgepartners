# Public site origin (canonical URLs, sitemap, RSS, OG tags). Set in Vercel for Production and Preview.
NEXT_PUBLIC_SITE_URL=https://falconbp.com

# ── Supabase (research admin: auth, reports, weekly scan, storage) ─────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...          # public; RLS-constrained
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...                   # SERVER ONLY — bypasses RLS

# ADMIN_PREVIEW_BYPASS=true   # Preview environment ONLY: lets reviewers open /admin without signing in. Ignored on production.
# Sign-in is by magic link to an address listed in public.admin_users (see supabase/001_research_admin.sql).
# Supabase → Authentication → URL Configuration: add https://falconbp.com/auth/callback and the Vercel preview origin to Redirect URLs.

# ── Existing ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM=
RESEND_CONTACT_EMAIL=
RESEND_RESEARCH_EMAIL=

# ── Weekly pipeline (October 2026) ────────────────────────────────────────
# Dropbox app (Scoped access · Full Dropbox · files.metadata.read + files.content.read).
# Redirect URI in the Dropbox app: https://falconbp.com/api/dropbox/callback (and the www host if it is used).
# The connection itself is made once from /admin/import and stored in public.app_secrets.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=                                        # SERVER ONLY
# DROPBOX_PUBLISH_PATH=/FalconBridge Workspace [Shared - All]/W. Website Publishing   # default shown
# RESEND_LEADS_EMAIL=info@falconbp.com                     # who is told when a pack is requested (default shown)
# PACK_LINK_DAYS=7                                         # how long an emailed pack link works (default shown)
# DISCOVERY_CALL_URL=https://calendly.com/falconbp-research/discovery   # booking link in the follow-up sent 48 hours after a first download (default shown)
# CRON_SECRET=   # optional: locks /api/cron/pack-follow-up (the daily follow-up job) to Vercel's scheduler
